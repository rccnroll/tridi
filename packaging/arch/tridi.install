# Old thumbnails of our formats (1.0's, or an older look) never get redrawn
# on their own: drop them for every user. STEP included: nothing draws those
# any more.
clear_thumbnails() {
  local d
  for d in /home/*/.cache/thumbnails /root/.cache/thumbnails; do
    [ -d "$d" ] && tridi clear-thumbnails "$d" >/dev/null
  done
  return 0
}

post_install() {
  clear_thumbnails
  cat <<'MSG'
==> tridi: pick the theme once per user (viewer, thumbnails, default app):
      tridi theme light     or     tridi theme dark
    File managers skip big files (Nautilus over 50 MB); to raise the limit:
      https://github.com/rccnroll/tridi#file-managers
MSG
}

post_upgrade() {
  clear_thumbnails
  # 2.6.0 renamed the .desktop: a default app set by `tridi theme` points
  # to the old name until the user runs it again
  if [ "$(vercmp "$2" 2.6.0)" -lt 0 ]; then
    echo '==> tridi: the app id is now io.github.rccnroll.tridi: run'
    echo '      tridi theme light     or     tridi theme dark'
    echo '    once per user, or double click stops opening tridi'
  fi
}
