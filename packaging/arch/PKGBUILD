# Builds the committed HEAD of this repo (not the working tree):
#   cd packaging/arch && makepkg -si
pkgname=tridi
pkgver=2.3.1
pkgrel=1
pkgdesc='Point cloud and mesh viewer, with Nautilus thumbnails'
arch=('x86_64')
url='https://github.com/rccnroll/tridi'
license=('MIT OR Apache-2.0')
# GL/EGL, Wayland and xkbcommon are dlopened at runtime
depends=('gcc-libs' 'glibc' 'libglvnd' 'mesa' 'wayland' 'libxkbcommon' 'xdg-utils')
makedepends=('cargo' 'git')
# renamed from pcdview after 2.2.0
conflicts=('pcdview')
replaces=('pcdview')
install=tridi.install
source=("tridi::git+file://$(realpath "$startdir/../..")")
sha256sums=('SKIP')
options=('!lto')

# the tag: 2.0.0 on v2.0.0 itself, 2.0.0.r3.gabc1234 three commits after it
pkgver() {
  cd tridi
  git describe --long --tags --match 'v*' | sed -E 's/^v//; s/-0-g[0-9a-f]+$//; s/-([0-9]+)-g/.r\1.g/'
}

prepare() {
  cd tridi
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd tridi
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # no build paths in the binary (panic messages carry source paths)
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=$HOME/.cargo=/cargo"
  cargo build --frozen --release
}

check() {
  cd tridi
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=$HOME/.cargo=/cargo"
  cargo test --frozen --release
}

package() {
  cd tridi
  install -Dm755 target/release/tridi "$pkgdir/usr/bin/tridi"
  install -Dm644 share/thumbnailers/tridi.thumbnailer -t "$pkgdir/usr/share/thumbnailers"
  install -Dm644 share/mime/packages/pointcloud.xml -t "$pkgdir/usr/share/mime/packages"
  install -Dm644 share/applications/tridi.desktop -t "$pkgdir/usr/share/applications"
  # one SVG, the rest are relative symlinks to it
  cp -a share/icons "$pkgdir/usr/share/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/tridi"
}
