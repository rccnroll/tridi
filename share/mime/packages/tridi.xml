<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-pcd">
    <comment>Point Cloud Data</comment>
    <comment xml:lang="it">Nuvola di punti (PCD)</comment>
    <!-- over image/x-photo-cd, which claims *.pcd too: PCD headers may
         start with any comment, or none, so the magic alone misses some -->
    <glob pattern="*.pcd" weight="60"/>
    <magic priority="60">
      <match type="string" value="# .PCD" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-xyz-pointcloud">
    <comment>XYZ point cloud</comment>
    <glob pattern="*.xyz"/>
    <glob pattern="*.xyzrgb"/>
  </mime-type>
  <!-- the next four are no distro's but f3d's (ply, pts, off) and newer
       shared-mime-info's (step): without f3d, or on Debian 12, Ubuntu 24.04
       and Fedora, no file had them. Same names as theirs, so they merge -->
  <mime-type type="application/vnd.ply">
    <comment>Polygon File Format</comment>
    <glob pattern="*.ply"/>
  </mime-type>
  <mime-type type="application/vnd.pts">
    <comment>Point cloud (PTS)</comment>
    <glob pattern="*.pts"/>
  </mime-type>
  <mime-type type="application/vnd.off">
    <comment>Object File Format</comment>
    <glob pattern="*.off"/>
  </mime-type>
  <mime-type type="model/step">
    <comment>STEP 3D model</comment>
    <generic-icon name="image-x-generic"/>
    <glob pattern="*.step"/>
    <glob pattern="*.stp"/>
    <magic>
      <match type="string" value="ISO-10303-21;" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
